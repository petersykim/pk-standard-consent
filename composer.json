{
    "name": "pk/standard-consent",
    "description": "Consent management for WordPress",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Peter Kim",
            "email": "peter.sy.kim@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1",
        "squizlabs/php_codesniffer": "^3.10",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PK\\StandardConsent\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpcs": "phpcs",
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "PK\\StandardConsent\\Tests\\": "tests/"
        }
    }
}
